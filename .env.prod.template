# =============================================================================
# Bailocam — Template variables d'environnement PRODUCTION
#
# Instructions :
#   1. Copier ce fichier en .env.prod sur le serveur
#   2. Remplir TOUTES les valeurs marquées CHANGE_ME
#   3. NE JAMAIS committer .env.prod sur Git (il est dans .gitignore)
#   Emplacement sur le VPS : /opt/bailocam/.env.prod
# =============================================================================

# ── Base de données PostgreSQL ────────────────────────────────────────────────
DB_NAME=immocam_db
DB_USERNAME=immocam_user
DB_PASSWORD=CHANGE_ME

# ── JWT (générer avec: openssl rand -hex 64) ──────────────────────────────────
JWT_SECRET=CHANGE_ME

# ── Email SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

EMAIL_FROM=CHANGE_ME
EMAIL_FROM_NAME=Bailocam

# ── Stockage uploads ──────────────────────────────────────────────────────────
STORAGE_BASE_URL=https://bailocam.com/uploads/

# ── Docker Registry (GitHub Container Registry) ───────────────────────────────
# Format : organization/repository (en minuscules)
GITHUB_REPOSITORY=wouandja/immocam
IMAGE_TAG=latest

# ── Spring ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
